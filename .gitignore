# --- OS ---
.DS_Store

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.venv/

# --- Runtime outputs (regenerable; never a source of truth) ---
runs/
logs/

# --- Activation caches and large tensors ---
caches/
*.pt
*.safetensors
*.npy
*.npz

# --- Downloaded model weights ---
models/
.cache/

# --- Scratch / temporary ---
scratch/
tmp/
*.tmp

# --- Versioned research data: never ignored, whatever matched above ---
!data/**

# --- Generated review output (derived; never edited by hand) ---
review/
!review/frozen/

# Personal editor settings stay local
.vscode/

# Raw third-party source files: fetched and verified from data/sources/downloads.yaml,
# never committed. Must come after the data/ rule above to take effect.
data/sources/raw/

# Generation run artefacts: requests, responses, raw traffic and logs are
# produced by a run, not by hand. The allocation is committed; a run is not.
data/pilot/requests/
data/pilot/responses/
data/pilot/raw/
data/pilot/smoke/
data/pilot/generation_log.jsonl

# The launcher writes this on the GPU host; it describes one server run.
data/pilot/server_runtime.json

# --- Model caches (never in the repository; they live under /data/$USER) ---
hf_cache/
.huggingface/
*.gguf
*.bin

# --- Credentials: nothing here is ever needed, and none must ever land ---
# The generator is a local model on the loopback interface, so the project has
# no key, token or secret of any kind. These patterns exist so that a stray one
# cannot be committed by accident.
.env
.env.*
.netrc
*.pem
*.key
secrets.yaml
secrets.yml
*credentials*.json
*token*.json

# --- Machine-specific odds and ends ---
.idea/
*.swp
*.log
nohup.out

# Live pilot run artefacts: the generation log, raw responses, per-call results
# and request files. Regenerable, large, and not research records in themselves;
# the approvals, the manual corrections, the corpus and its manifest ARE, and
# stay tracked.
data/pilot/run/
